{
  "name": "@enspack/indexer",
  "version": "0.1.0",
  "description": "enspack indexer: Ponder app for TextChanged/ContenthashChanged plus the §4.3 JSON API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "echo ponder has no compile step",
    "codegen": "ponder codegen",
    "typecheck": "ponder codegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "dev": "ponder dev",
    "start": "ponder start"
  },
  "dependencies": {
    "@enspack/core": "workspace:*",
    "hono": "^4.7.0",
    "ponder": "0.16.10",
    "viem": "^2.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
