# Copy to .env and fill in. Never commit real values.
# Compose interpolates these; the API container also receives them as env.

PORT=8080
SEED_PORT=8080

# linuxserver qBittorrent WebUI (host port must equal WEBUI_PORT)
QBT_WEBUI_PORT=8081
QBT_URL=http://qbittorrent:8081
QBT_USER=
QBT_PASS=

KUBO_API=http://kubo:5001
KUBO_GATEWAY_PORT=8090

ETH_RPC_URL=
SEPOLIA_RPC_URL=
ENSPACK_CHAIN=sepolia
# Optional. Default v2 on sepolia, v1 on mainnet.
# ENSPACK_ENS_VERSION=v2

# Comma-separated. publisher must equal a root or end with .<root>
SEED_ALLOW_ROOTS=enspack.eth

# 2 TiB in bytes
SEED_QUOTA_BYTES_PER_PUBLISHER=2199023255552

# Empty = @enspack/core LICENSE_ALLOWLIST
SEED_LICENSE_ALLOWLIST=

SEED_DOWNLOAD_DIR=/downloads
