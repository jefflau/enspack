{
  "name": "@enspack/bootstrap",
  "version": "0.1.0",
  "description": "Bootstrap runner that mirrors models.yaml under mirrors.enspack.eth (BOOTSTRAP.md §5)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "enspack-bootstrap": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "models.yaml", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@enspack/core": "workspace:*",
    "@enspack/hf": "workspace:*",
    "@enspack/torrent": "workspace:*",
    "viem": "^2.28.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
