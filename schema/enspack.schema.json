{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enspack.eth.limo/schema/enspack-0.1.json",
  "title": "enspack manifest 0.1",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": [
    "spec",
    "name",
    "model",
    "publisher",
    "version",
    "createdAt",
    "license",
    "distribution",
    "files",
    "totalSize",
    "versions"
  ],
  "properties": {
    "spec": { "const": "enspack/0.1" },
    "name": { "$ref": "#/$defs/ensName", "description": "ENS name of this version" },
    "model": { "$ref": "#/$defs/ensName", "description": "ENS name of the mutable model pointer" },
    "publisher": { "$ref": "#/$defs/ensName" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "displayName": { "type": "string", "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "license": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.+-]*$",
      "description": "SPDX id, lowercase"
    },
    "licenseUrl": { "type": "string", "format": "uri" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repo", "url", "revision"],
      "properties": {
        "provider": { "enum": ["huggingface", "modelscope", "github", "other"] },
        "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 7, "maxLength": 128 }
      }
    },
    "canonical": {
      "$ref": "#/$defs/ensName",
      "description": "Publisher-verified name for the same artifact, if this is a mirror"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": {} },
      "required": ["infohash", "magnet", "webseeds"],
      "properties": {
        "infohash": { "$ref": "#/$defs/hex40" },
        "infohashV2": { "$ref": "#/$defs/hex64" },
        "magnet": { "type": "string", "pattern": "^magnet:\\?xt=urn:btih:[0-9a-fA-F]{40}(&.*)?$" },
        "torrent": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "cid": { "$ref": "#/$defs/cid" },
            "url": { "type": "string", "format": "uri" }
          }
        },
        "webseeds": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https://.*/$" },
          "uniqueItems": true
        },
        "seeds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9.-]+:\\d{1,5}$" },
          "uniqueItems": true
        },
        "ipfs": { "$ref": "#/$defs/cid" },
        "oci": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(:\\d+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"
        },
        "hb": { "type": "string", "pattern": "^hb://[^/@\\s]+/[^/@\\s]+@sha256:[0-9a-f]{64}$" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/hex64" },
          "role": {
            "enum": ["weight", "config", "tokenizer", "index", "doc", "license", "code", "other"]
          }
        }
      }
    },
    "totalSize": { "type": "integer", "minimum": 0 },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "name", "cid", "createdAt"],
        "properties": {
          "version": { "type": "string" },
          "name": { "$ref": "#/$defs/ensName" },
          "cid": { "$ref": "#/$defs/cid" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "previous": { "$ref": "#/$defs/cid" }
  },
  "$defs": {
    "ensName": {
      "type": "string",
      "pattern": "^(_?[a-z0-9-]+\\.)+[a-z0-9-]+$",
      "maxLength": 255
    },
    "hex40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cid": { "type": "string", "pattern": "^(bafy|bafk|bafyb|Qm)[A-Za-z0-9]{20,}$" }
  }
}
