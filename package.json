{
  "name": "enspack-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "validate:examples": "node scripts/validate-examples.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "vitest": "^3.0.0"
  }
}
