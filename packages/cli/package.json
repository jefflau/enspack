{
  "name": "@enspack/cli",
  "version": "0.1.0",
  "description": "enspack CLI: named, verifiable model-weight fetch and publish (SPEC §4, §5, §8, §9)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "enspack": "./bin/enspack.js",
    "ensget": "./bin/ensget.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "bin"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@enspack/core": "workspace:*",
    "@enspack/hf": "workspace:*",
    "@enspack/torrent": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "viem": "^2.28.0",
    "vitest": "^3.0.0"
  }
}
