// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ens-setup > snapshots --help 1`] = `
"Usage: enspack ens-setup [options]

One-shot ENSv2 on-chain setup for a publisher name (Sepolia)

Options:
  --name <name>            ENS name to set up (e.g. enspack.eth)
  --subname <label>        direct child label to register (repeatable)
  --operator <address>     hot operator to grant REGISTRAR|RENEW and resolver
                           record roles
  --dry-run                print the plan without sending transactions
  --json                   print machine-readable JSON to stdout (nothing else
                           on stdout)
  --chain <chain>          ENS chain: mainnet or sepolia (default: "mainnet")
  --ens-version <version>  ENS version: v1 or v2 (default: v2 on sepolia, v1 on
                           mainnet)
  -h, --help               display help for command
"
`;
