{
  "name": "@enspack/torrent",
  "version": "0.1.0",
  "description": "enspack torrent: metainfo create/parse, aria2c downloader, SHA-256 verifier",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "generate-fixture": "node --experimental-strip-types scripts/generate-tiny-model.ts"
  },
  "dependencies": {
    "@enspack/core": "workspace:*",
    "create-torrent": "^6.1.3",
    "parse-torrent": "^11.0.24",
    "picomatch": "^4.0.2",
    "piece-length": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.2",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
